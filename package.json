{
  "name": "building-blocks-simulator",
  "version": "1.0.0",
  "description": "Notan, a black-and-white block puzzle: make packs of designs, print their cards, box and rules, and preview what a buyer gets.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check-build": "node scripts/build.mjs && git diff --exit-code -- index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gleal42/building-blocks-simulator.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
